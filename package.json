{
  "name": "nextjs-prisma",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate --config prisma7.config.ts",
    "vercel-build": "node scripts/vercel-build.mjs",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate": "prisma migrate dev --config prisma7.config.ts",
    "db:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "db:seed": "prisma db seed --config prisma7.config.ts",
    "db:studio": "prisma studio --config prisma7.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tailwindcss/postcss": "^4.3.5",
    "dotenv": "^18.0.10",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "postcss": "^8.5.33",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
